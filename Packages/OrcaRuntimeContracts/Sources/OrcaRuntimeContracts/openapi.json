        "description": "Canonical provider-independent read model for one accepted turn.",
        "properties": {
          "adapter": {
            "$ref": "#/components/schemas/ChatRuntimeAdapterRef"
          },
          "agent_id": {
            "format": "uuid",
            "title": "Agent Id",
            "type": "string"
          },
          "conversation_id": {
            "format": "uuid",
            "title": "Conversation Id",
            "type": "string"
          },
