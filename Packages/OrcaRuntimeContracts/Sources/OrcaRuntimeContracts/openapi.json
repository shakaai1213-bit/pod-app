  "info": {
    "description": "Provider-neutral named-agent runtime contract.",
    "title": "ORCA Chat Runtime API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/chat-runtime/v1/conformance/complete-turn": {
      "get": {
        "description": "Returns a deterministic provider-neutral accepted-to-terminal turn for generated client decoding, ordering, and replay conformance tests.",
        "operationId": "get_chat_runtime_conformance_turn_api_v1_chat_runtime_v1_conformance_complete_turn_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatRuntimeTurnRead"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Read ORCA Chat Runtime v1 Complete-Turn Fixture",
        "tags": [
          "chat-runtime"
        ]
      }
    },
    "/api/v1/chat-runtime/v1/contract": {
      "get": {
        "description": "Returns the provider-neutral authority, lifecycle, progress, adapter, transport, and compatibility contract for named-agent chat clients.",
        "operationId": "get_chat_runtime_contract_api_v1_chat_runtime_v1_contract_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatRuntimeContractRead"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Read ORCA Chat Runtime v1 Contract",
        "tags": [
          "chat-runtime"
        ]
      }
    },
    "/api/v1/chat-runtime/v1/schema-bundle": {
      "get": {
        "description": "Returns deterministic provider-neutral JSON schemas for runtime, event, adapter, resource, and terminal-outcome client generation.",
        "operationId": "get_chat_runtime_schema_bundle_api_v1_chat_runtime_v1_schema_bundle_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatRuntimeSchemaBundleRead"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Read ORCA Chat Runtime v1 Schema Bundle",
        "tags": [
          "chat-runtime"
        ]
      }
    }
  },
