            "type": "string"
          }
        },
        "required": [
          "state",
          "summary",
          "completed_at"
        ],
        "title": "ChatRuntimeTerminalOutcomeRead",
        "type": "object"
      },
      "ChatRuntimeTimelineEventRead": {
        "description": "Ordered event envelope shared by REST reads and resumable streams.",
        "properties": {
          "actor_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Actor Id",
            "type": "string"
          },
          "actor_type": {
            "$ref": "#/components/schemas/ChatRuntimeActorType"
          },
          "agent_id": {
            "format": "uuid",
