{
  "components": {
    "schemas": {
      "ChatRuntimeActorType": {
        "enum": [
          "user",
          "agent",
          "system",
          "adapter",
          "worker"
        ],
        "title": "ChatRuntimeActorType",
        "type": "string"
      },
      "ChatRuntimeAdapterContractRead": {
        "properties": {
          "credential_owner": {
            "const": "central_secret_broker",
            "default": "central_secret_broker",
            "title": "Credential Owner",
            "type": "string"
          },
          "identity_owner": {
            "const": "named_agent",
            "default": "named_agent",
            "title": "Identity Owner",
            "type": "string"
          },
          "memory_owner": {
            "const": "orca",
            "default": "orca",
            "title": "Memory Owner",
            "type": "string"
          },
          "provider_identifiers_are_extensible": {
            "default": true,
            "title": "Provider Identifiers Are Extensible",
            "type": "boolean"
          },
          "reference_schema": {
            "default": "ChatRuntimeAdapterRef",
            "title": "Reference Schema",
            "type": "string"
          },
          "resource_envelope_schema": {
            "default": "ChatRuntimeResourceEnvelope",
            "title": "Resource Envelope Schema",
            "type": "string"
          },
          "secrets_allowed_in_payloads": {
            "default": false,
            "title": "Secrets Allowed In Payloads",
            "type": "boolean"
          },
          "selection_owner": {
            "const": "orca",
            "default": "orca",
            "title": "Selection Owner",
            "type": "string"
          }
        },
        "title": "ChatRuntimeAdapterContractRead",
        "type": "object"
      },
      "ChatRuntimeAdapterRef": {
        "description": "Execution adapter selected for a turn without transferring ORCA ownership.",
        "properties": {
          "adapter_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Adapter Id",
            "type": "string"
          },
          "execution_mode": {
            "enum": [
              "local",
              "remote",
              "hybrid"
            ],
            "title": "Execution Mode",
            "type": "string"
          },
          "host_id": {
            "maxLength": 128,
            "title": "Host Id",
            "type": "string"
          },
          "model_id": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Model Id",
            "type": "string"
          },
          "provider_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Provider Id",
            "type": "string"
          }
        },
        "required": [
          "adapter_id",
          "provider_id",
          "model_id",
          "execution_mode"
        ],
        "title": "ChatRuntimeAdapterRef",
        "type": "object"
      },
      "ChatRuntimeCompatibilityRouteRead": {
        "properties": {
          "current_route": {
            "title": "Current Route",
            "type": "string"
          },
          "runtime_resource": {
            "title": "Runtime Resource",
            "type": "string"
          },
          "transition": {
            "enum": [
              "preserve",
              "adapt",
              "replace_after_parity"
            ],
            "title": "Transition",
            "type": "string"
          }
        },
        "required": [
          "current_route",
          "runtime_resource",
          "transition"
        ],
        "title": "ChatRuntimeCompatibilityRouteRead",
        "type": "object"
      },
      "ChatRuntimeContractRead": {
        "description": "Versioned public contract for provider-independent named-agent chat.",
        "properties": {
          "adapter": {
            "$ref": "#/components/schemas/ChatRuntimeAdapterContractRead"
          },
          "authority": {
            "const": "orca",
            "default": "orca",
            "title": "Authority",
            "type": "string"
          },
          "compatibility_routes": {
            "items": {
              "$ref": "#/components/schemas/ChatRuntimeCompatibilityRouteRead"
            },
            "title": "Compatibility Routes",
            "type": "array"
          },
          "contract_version": {
            "const": "orca.chat-runtime.v1",
            "default": "orca.chat-runtime.v1",
            "title": "Contract Version",
            "type": "string"
          },
          "invariants": {
            "items": {
              "$ref": "#/components/schemas/ChatRuntimeInvariantRead"
            },
            "title": "Invariants",
            "type": "array"
          },
          "lifecycle": {
            "const": "schoolhouse",
            "default": "schoolhouse",
            "title": "Lifecycle",
            "type": "string"
          },
          "maturity": {
            "const": "foundation",
            "default": "foundation",
            "title": "Maturity",
            "type": "string"
          },
          "provider_binding": {
            "const": "adapter",
            "default": "adapter",
            "title": "Provider Binding",
            "type": "string"
          },
          "resources": {
            "items": {
              "type": "string"
            },
            "title": "Resources",
            "type": "array"
          },
          "router": {
            "const": "cascade",
            "default": "cascade",
            "title": "Router",
            "type": "string"
          },
          "transports": {
            "items": {
              "enum": [
                "rest",
                "resumable_sse"
              ],
              "type": "string"
            },
            "title": "Transports",
            "type": "array"
          },
          "turn": {
            "$ref": "#/components/schemas/ChatRuntimeTurnContractRead"
          }
        },
        "required": [
          "transports",
          "resources",
          "adapter",
          "turn",
          "invariants",
          "compatibility_routes"
        ],
        "title": "ChatRuntimeContractRead",
        "type": "object"
      },
      "ChatRuntimeEventType": {
        "description": "Cross-provider events that form one resumable turn timeline.",
        "enum": [
          "message.accepted",
          "turn.claimed",
          "turn.progress",
          "lifecycle.updated",
          "route.decided",
          "tool.requested",
          "tool.completed",
          "tool.failed",
          "approval.requested",
          "approval.decided",
          "escalation.updated",
          "worker.updated",
          "artifact.recorded",
          "memory.updated",
          "turn.completed",
          "turn.failed",
          "turn.cancelled"
        ],
        "title": "ChatRuntimeEventType",
        "type": "string"
      },
      "ChatRuntimeInvariantRead": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          }
        },
        "required": [
          "code",
          "description"
        ],
        "title": "ChatRuntimeInvariantRead",
        "type": "object"
      },
      "ChatRuntimeProgressState": {
        "description": "Canonical client-visible progress states for one runtime turn.",
        "enum": [
          "accepted",
          "claimed",
          "working",
          "blocked",
          "approval_needed",
          "completed",
          "failed",
          "cancelled"
        ],
        "title": "ChatRuntimeProgressState",
        "type": "string"
      },
