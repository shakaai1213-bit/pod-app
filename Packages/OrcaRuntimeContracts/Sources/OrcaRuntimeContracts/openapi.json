        "description": "Governed execution limits passed to any selected provider adapter.",
        "properties": {
          "allowed_root_refs": {
            "items": {
              "type": "string"
            },
            "title": "Allowed Root Refs",
            "type": "array"
          },
          "allowed_tool_ids": {
            "items": {
              "type": "string"
            },
            "title": "Allowed Tool Ids",
            "type": "array"
          },
          "approval_rule_ids": {
            "items": {
              "type": "string"
            },
            "title": "Approval Rule Ids",
            "type": "array"
          },
          "compute_budget_units": {
            "minimum": 0.0,
            "title": "Compute Budget Units",
            "type": "integer"
          },
          "deadline_at": {
            "format": "date-time",
            "title": "Deadline At",
            "type": "string"
          },
          "max_concurrent_workers": {
            "default": 1,
            "maximum": 64.0,
            "minimum": 1.0,
            "title": "Max Concurrent Workers",
            "type": "integer"
          },
          "network_access": {
            "default": "governed",
            "enum": [
              "denied",
              "governed",
              "allowed"
            ],
            "title": "Network Access",
            "type": "string"
          },
          "provider_rungs": {
            "items": {
              "type": "string"
            },
            "title": "Provider Rungs",
            "type": "array"
          }
        },
        "title": "ChatRuntimeResourceEnvelope",
        "type": "object"
      },
      "ChatRuntimeSchemaBundleRead": {
        "properties": {
          "contract_version": {
            "const": "orca.chat-runtime.v1",
            "default": "orca.chat-runtime.v1",
            "title": "Contract Version",
            "type": "string"
          },
          "schema_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Schema Sha256",
            "type": "string"
          },
          "schemas": {
            "additionalProperties": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Schemas",
            "type": "object"
          }
        },
        "required": [
          "schema_sha256",
          "schemas"
        ],
        "title": "ChatRuntimeSchemaBundleRead",
        "type": "object"
      },
      "ChatRuntimeTerminalOutcomeRead": {
        "properties": {
          "completed_at": {
            "format": "date-time",
