        "properties": {
          "evidence_refs": {
            "items": {
              "type": "string"
            },
            "title": "Evidence Refs",
            "type": "array"
          },
          "source_ref": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Source Ref",
            "type": "string"
          },
          "trace_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "source_ref",
          "trace_id"
        ],
        "title": "ChatRuntimeProvenanceRead",
        "type": "object"
      },
