        "required": [
          "event_id",
          "sequence",
          "cursor",
          "conversation_id",
          "turn_id",
          "agent_id",
          "event_type",
          "actor_type",
          "actor_id",
          "occurred_at",
          "provenance"
        ],
        "title": "ChatRuntimeTimelineEventRead",
        "type": "object"
      },
