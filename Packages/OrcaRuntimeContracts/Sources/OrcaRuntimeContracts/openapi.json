            },
            "title": "Events",
            "type": "array"
          },
          "idempotency_key": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Idempotency Key",
            "type": "string"
          },
          "latest_cursor": {
            "maxLength": 256,
            "title": "Latest Cursor",
            "type": "string"
          },
          "message_id": {
            "format": "uuid",
            "title": "Message Id",
